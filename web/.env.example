# The web app reads ONE variable, the POOLED Neon string.
#
#   local  — it comes from the repo-root .env, which is gitignored and which
#            you fill in yourself. Nothing to copy here.
#   Vercel — set it as a project environment variable (Task 21).
#
# The pooled host has "-pooler" in it. The direct string (DATABASE_URL) is for
# ingestion and migrations and is deliberately NOT a fallback.

DATABASE_URL_POOLED=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/DBNAME?sslmode=require
